{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../generated/**/*",
        "outDir": "dist/generated"
      }
    ],
    "webpack": true
  },
  "projects": {
    "nats-jetstream": {
      "type": "library",
      "root": "libs/nats-jetstream",
      "entryFile": "index",
      "sourceRoot": "libs/nats-jetstream/src",
      "compilerOptions": {
        "tsConfigPath": "libs/nats-jetstream/tsconfig.lib.json"
      }
    }
  }
}